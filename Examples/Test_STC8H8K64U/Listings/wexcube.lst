               * @return const char* 字符串指针，临时变量需要尽快使用
               */
              const char* wex_intToStr(wex_s32_t slInt)
              {
                  sprintf(_wexStrBuf, "%ld", slInt);
                  return (const char*)_wexStrBuf;
              }
