  56          /**
  57            * @brief  This function handles UART interrupt request.
  58            * @param  None
  59            * @retval None
  60            */
  61          void UART2_Isr() interrupt 8
  62          {
  63   1              // 发送中断
  64   1          if (S2CON & S2TI)
  65   1          {
  66   2              S2CON &= ~S2TI;                         //清中断标志
  67   2                      txBusy = 0;
  68   2          }
  69   1              
  70   1              // 接收中断
  71   1          if (S2CON & S2RI)
  72   1          {
  73   2                      wex_u8_t recData = S2BUF;
  74   2              S2CON &= ~S2RI;                         //清中断标志
  75   2                      wex_push(&recData, 1);
  76   2          }   
  77   1      }


