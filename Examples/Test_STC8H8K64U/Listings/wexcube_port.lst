  17          bit txBusy = 0;
  18          
  19          /**
  20           * @brief 串口初始化函数
  21           * 
  22           */
  23          void wex_port_init(void)
  24          {
  25   1              //115200bps@33.1776MHz
  26   1              S2CON = 0x50;           //8位数据,可变波特率
  27   1              AUXR |= 0x04;           //定时器时钟1T模式
  28   1              T2L = 0xB8;                     //设置定时初始值
  29   1              T2H = 0xFF;                     //设置定时初始值
  30   1              AUXR |= 0x10;           //定时器2开始计时
  31   1              IE2 |= 0x01;            //使能串口2中断
  32   1              
  33   1              P_SW2 &= ~0x01;         //UART2/USART2: RxD2(P1.0), TxD2(P1.1)
  34   1      }
  35          
  36          
  37          /**
  38           * @brief 发送数据
  39           * 
  40           * @param pucData 数据指针
  41           * @param ucLen 数据长度
  42           */
  43          void wex_port_send(wex_u8_t *pucData, wex_u8_t ucLen)
  44          {
  45   1              wex_u8_t n = ucLen;
  46   1      
  47   1              while(n--)
  48   1              {
  49   2                      while(txBusy);
  50   2                      S2BUF = *pucData++;
  51   2                      txBusy = 1;
  52   2              }
  53   1      }
